    /**
     * Generate a unique UUID v4
     */
    private function generateUUID()
    {
        $data = random_bytes(16);
        $data[6] = chr(ord($data[6]) & 0x0f | 0x40);
        $data[8] = chr(ord($data[8]) & 0x3f | 0x80);
        return vsprintf('%s%s-%s-%s-%s-%s%s%s', str_split(bin2hex($data), 4));
    }

    /**
     * Create or update React configuration file
     */
    private function createReactConfigFile()
    {
        $configDir = $this->dir . DIRECTORY_SEPARATOR . 'Config';
        $this->createDirectoryIfNotExists($configDir);

        $configPath = $configDir . DIRECTORY_SEPARATOR . 'React.php';
        $namespace = $this->readNamespace();

        if (file_exists($configPath)) {
            $this->showInfo("React.php already exists, updating configuration...");
            $this->updateReactConfig($configPath);
        } else {
            $this->showInfo("Creating React.php configuration file...");
            $uuid = $this->generateUUID();
            $configContent = $this->getReactConfigTemplate($namespace, $uuid);
            file_put_contents($configPath, $configContent);
            $this->showSuccess("React.php created in Config/");
        }
    }

    /**
     * Update existing React configuration file
     */
    private function updateReactConfig($configPath)
    {
        $content = file_get_contents($configPath);
        
        // Check if it's the old class format and needs conversion
        if (strpos($content, 'class React') !== false) {
            $this->showInfo("Converting old class format to array format...");
            $uuid = $this->generateUUID();
            $namespace = $this->readNamespace();
            $configContent = $this->getReactConfigTemplate($namespace, $uuid);
            file_put_contents($configPath, $configContent);
            $this->showSuccess("React configuration converted to array format!");
        } elseif (strpos($content, "'container_id'") === false && strpos($content, '"container_id"') === false) {
            // If it's already an array but missing container_id, regenerate
            $this->showInfo("Updating React configuration...");
            $uuid = $this->generateUUID();
            $namespace = $this->readNamespace();
            $configContent = $this->getReactConfigTemplate($namespace, $uuid);
            file_put_contents($configPath, $configContent);
            $this->showSuccess("React configuration updated!");
        } else {
            $this->showInfo("React configuration is up to date.");
        }
    }

