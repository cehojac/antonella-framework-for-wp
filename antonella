    /**
     * Create React Core class in src/Core/React.php
     */
    private function createReactCoreClass()
    {
        $coreDir = $this->dir . DIRECTORY_SEPARATOR . 'src' . DIRECTORY_SEPARATOR . 'Core';
        $this->createDirectoryIfNotExists($coreDir);
        
        $namespace = $this->readNamespace();
        $reactClassPath = $coreDir . DIRECTORY_SEPARATOR . 'React.php';
        
        $reactClassContent = <<<'REACTCLASS'
<?php

namespace __NAMESPACE__\Core;

use Closure;

/**
 * React Component Renderer
 * 
 * Inspired by Inertia.js WordPress adapter architecture
 * Provides a clean API to render React components from WordPress templates
 * 
 * @package __NAMESPACE__\Core
 */
class React
{
    /**
     * React configuration
     * 
     * @var array|null
     */
    protected static $config = null;

    /**
     * Current component name
     * 
     * @var string|null
     */
    protected static $component = null;

    /**
     * Component props
     * 
     * @var array
     */
    protected static $props = [];

    /**
     * Shared props (available to all components)
     * 
     * @var array
     */
    protected static $sharedProps = [];

    /**
     * Root template file
     * 
     * @var string
     */
    protected static $rootView = 'app.php';

    /**
     * Asset version for cache busting
     * 
     * @var string|null
     */
    protected static $version = null;

    /**
     * Page data to be injected
     * 
     * @var array|null
     */
    protected static $pageData = null;

    /**
     * Cached manifest data
     * 
     * @var array|null
     */
    protected static $manifest = null;

    /**
     * Flag to prevent duplicate asset loading
     * 
     * @var bool
     */
    protected static $assetsEnqueued = false;

    /**
     * Track which controllers have already been booted
     * 
     * @var array
     */
    protected static $bootedControllers = [];

    /**
     * Render a React component
     * 
     * Returns the HTML string so it works in both contexts:
     * - Admin pages: echo React::render('Component', $props);
     * - Shortcodes: return React::render('Component', $props);
     * 
     * @param string $component Component name (e.g., 'Posts/Index')
     * @param array $props Component props
     * @return string HTML output
     */
    public static function render(string $component, array $props = [])
    {
        self::loadConfig();
        self::bootController();
        self::setComponent($component);
        self::setProps($props);
        
        self::$pageData = [
            'component' => self::$component,
            'props' => self::$props,
            'version' => self::$version,
            'url' => self::getCurrentUrl(),
        ];

        // Enqueue React scripts (dev or production based on config)
        self::enqueueScripts();

        // Capture output and return as string
        ob_start();
        self::renderDefaultTemplate();
        return ob_get_clean();
    }

    /**
     * Auto-detect the calling controller and run its boot() method once
     * 
     * @return void
     */
    protected static function bootController()
    {
        $trace = debug_backtrace(DEBUG_BACKTRACE_IGNORE_ARGS, 3);

        foreach ($trace as $frame) {
            if (!isset($frame['class']) || $frame['class'] === __CLASS__) {
                continue;
            }

            $controllerClass = $frame['class'];

            if (in_array($controllerClass, self::$bootedControllers, true)) {
                return;
            }

            if (method_exists($controllerClass, 'boot')) {
