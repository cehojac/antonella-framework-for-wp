    /**
     * Create main React app file
     */
    private function createReactApp()
    {
        $appContent = "import React from 'react';
import { createRoot } from 'react-dom/client';

// Import all components
import ExampleComponent from './Pages/ExampleComponent';
import HelloWorld from './Pages/HelloWorld';

// Component registry
const components = {
  ExampleComponent,
  HelloWorld,
};

// Main App Component
function App({ component, props }) {
  const Component = components[component];
  
  if (!Component) {
    throw new Error(`Component not found: ${component}`);
  }
  
  return <Component {...props} />;
}

// Mount React app
// Get container ID from meta tag
const containerId = document.querySelector('meta[name=\"antonella-react-container\"]')?.content;

if (!containerId) {
  console.error('React container ID not found in meta tags');
} else {
  const container = document.getElementById(containerId);
  
  if (!container) {
    console.error(`React container with ID \"${containerId}\" not found in DOM`);
  } else {
    // Get page data from data attribute
    const pageDataAttr = container.getAttribute('data-page');
  
    if (pageDataAttr) {
      try {
        const pageData = JSON.parse(pageDataAttr);
        const root = createRoot(container);
        root.render(<App component={pageData.component} props={pageData.props} />);
      } catch (error) {
        console.error('Failed to parse page data:', error);
        console.error('Page data attribute:', pageDataAttr);
        const root = createRoot(container);
        root.render(
          <div style={{ padding: '20px', color: 'red' }}>
            <h1>Error loading React component</h1>
            <p>{error.message}</p>
            <pre style={{ background: '#f5f5f5', padding: '10px', overflow: 'auto' }}>
              {pageDataAttr}
            </pre>
          </div>
        );
      }
    } else {
      console.warn('Container found but no data-page attribute');
      const root = createRoot(container);
      root.render(
        <div className=\"antonella-react-app\">
          <h1>Welcome to Antonella Framework + React</h1>
          <ExampleComponent />
        </div>
      );
    }
  }
}";

        $appPath = $this->dir . DIRECTORY_SEPARATOR . 'resources' . DIRECTORY_SEPARATOR . 'js' . DIRECTORY_SEPARATOR . 'app.jsx';
