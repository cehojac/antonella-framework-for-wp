    }

    /**
     * Update existing package.json with React dependencies
     */
    private function updatePackageJson($path)
    {
        $packageJson = json_decode(file_get_contents($path), true);

        if (!isset($packageJson['dependencies'])) {
            $packageJson['dependencies'] = [];
        }
        if (!isset($packageJson['devDependencies'])) {
            $packageJson['devDependencies'] = [];
        }
        if (!isset($packageJson['scripts'])) {
            $packageJson['scripts'] = [];
        }

        $packageJson['type'] = 'module';
        $packageJson['dependencies']['react'] = '^19.2.4';
        $packageJson['dependencies']['react-dom'] = '^19.2.4';
        $packageJson['devDependencies']['@vitejs/plugin-react'] = '^5.1.3';
        $packageJson['devDependencies']['vite'] = '^7.3.1';
        $packageJson['scripts']['dev'] = 'vite';
        $packageJson['scripts']['build'] = 'vite build';
        $packageJson['scripts']['preview'] = 'vite preview';

        file_put_contents($path, json_encode($packageJson, JSON_PRETTY_PRINT | JSON_UNESCAPED_SLASHES));
        $this->showSuccess("package.json updated with React dependencies!");
    }

